# ---------------------------------------------------------------------------
# SCOUT AI configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Providers: "openai"/"tavily" for real research; "mock" for an offline demo with a
# FICTIONAL fixture corpus (no API keys, no cost). Mock is never used unless set here.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
SEARCH_PROVIDER=tavily

OPENAI_API_KEY=
TAVILY_API_KEY=

# Models (any chat model that supports structured outputs works)
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REPORT_MODEL=gpt-5.5      # optional stronger model for report writing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                  # must match the DB migration; change before first migrate

# Cost estimates (USD per 1M tokens) - set to your actual prices
PRICE_INPUT_PER_MTOK=0.75
PRICE_OUTPUT_PER_MTOK=4.50
PRICE_EMBEDDING_PER_MTOK=0.02

# Database (docker compose exposes Postgres on 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5433/scout
POSTGRES_PASSWORD=scout

# Limits / security
UPLOAD_MAX_MB=20
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_JOBS=3
FETCH_TIMEOUT_S=15
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Background execution: "inline" (jobs run in the API process) or "worker" (API enqueues;
# `python -m app.worker` processes claim jobs from Postgres). Use the same value for API and workers.
JOB_EXECUTION=inline
# WORKER_HEARTBEAT_S=10
# WORKER_LEASE_S=60                 # running job without a heartbeat this long -> requeued
# WORKER_MAX_ATTEMPTS=3

# Second-stage reranking: none | cross_encoder (local ONNX model; `uv sync --extra rerank`) | lexical
RERANKER=none
# RERANK_CANDIDATES=30

# Tracing (OpenTelemetry over OTLP/HTTP), e.g. Jaeger: docker compose --profile observability up -d
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Public demo guardrails (docker-compose.prod.yml turns DEMO_MODE on)
DEMO_MODE=false
# DEMO_MAX_DEPTH=quick
# DEMO_JOBS_PER_CLIENT_PER_DAY=3
# DEMO_DAILY_COST_CAP_USD=2.0
# DEMO_ALLOW_UPLOADS=false
# DOMAIN=scout.example.com          # production compose: Caddy gets a TLS certificate for this name

# Mock providers only: simulated latency per LLM call so offline demos stream like real runs
# MOCK_LATENCY_MS=300
